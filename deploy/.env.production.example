# Production application environment.
#
# Copy to /opt/daily-reflection-bot/.env on the server and fill in the secrets.
# This file is server-only: it is NOT managed by CI, never committed, and never
# read or modified by the GitHub Actions workflow.
#
#   chmod 600 .env
#
# This template contains no real secrets.

# Secrets — set manually on the server, never in git or the workflow.
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_IDS=

# Application settings.
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_CHECKIN_TIME=21:30
DEFAULT_REMINDER_TIME=23:00
DEFAULT_MORNING_TIME=08:30
LOG_LEVEL=INFO

# Absolute path inside the container; /app/data is bind-mounted to ./data.
DATABASE_URL=sqlite:////app/data/reflection.db
